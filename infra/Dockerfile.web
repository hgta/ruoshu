FROM php:8.3-fpm-alpine

# 系统依赖（intl / zip / opcache 等 Laravel 必需扩展）
RUN apk add --no-cache \
        git \
        curl \
        libpng-dev \
        libzip-dev \
        zip \
        unzip \
        icu-dev \
        oniguruma-dev \
        linux-headers \
    && docker-php-ext-install pdo_mysql bcmath gd intl zip opcache pcntl

# Composer
COPY --from=composer:2.7 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# 默认命令由 docker-compose 覆写
CMD ["php-fpm"]
FROM python:3.12-slim

WORKDIR /app

# 系统依赖（构建 uvicorn 标准版需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app/

ENV AI_BIND_HOST=0.0.0.0
ENV AI_PORT=9000
EXPOSE 9000

# 健康检查（容器内调用 localhost，因网关仅内网暴露）
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:9000/healthz').read()" || exit 1

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "9000"]